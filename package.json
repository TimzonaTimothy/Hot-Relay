{
  "name": "hot-relay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hot Relay — browser/PWA run-and-gun prototype (Gate 3)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
