{
  "name": "hot-relay",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "e2e": "node scripts/smoke.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "idb-keyval": "6.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3"
  }
}
